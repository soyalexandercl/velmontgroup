# Entorno
NODE_ENV=production
PORT=3000
APP_URL=https://velmontgroup.cl

# Base de datos PostgreSQL
# En despliegue con docker-compose, el host es "postgres" (nombre del servicio)
# y POSTGRES_PASSWORD debe coincidir con la contrasena de DATABASE_URL
DATABASE_URL=postgres://velmont:reemplaza_con_password_fuerte@postgres:5432/velmontgroup
POSTGRES_PASSWORD=reemplaza_con_password_fuerte

# Destino del formulario de contacto (se envia via FormSubmit, sin credenciales).
# La primera vez hay que confirmar el correo de activacion que llega a este buzon.
CONTACT_EMAIL_TO=velmontgroupspa@gmail.com

# Rate limiting del formulario de contacto
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10