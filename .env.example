# Entorno
NODE_ENV=production
PORT=3000
APP_URL=https://velmontgroup.cl

# Base de datos PostgreSQL
# En despliegue con docker-compose, el host es "postgres" (nombre del servicio)
# y POSTGRES_PASSWORD debe coincidir con la contrasena de DATABASE_URL
DATABASE_URL=postgres://velmont:reemplaza_con_password_fuerte@postgres:5432/velmontgroup
POSTGRES_PASSWORD=reemplaza_con_password_fuerte

# SMTP (envio de notificaciones del formulario de contacto)
# Hostinger Email: smtp.hostinger.com puerto 465 (SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@velmontgroup.cl
SMTP_PASS=reemplaza_con_la_password_del_buzon
SMTP_FROM="Velmont Group SpA <contacto@velmontgroup.cl>"
CONTACT_EMAIL_TO=velmontgroupspa@gmail.com

# Rate limiting del formulario de contacto
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
